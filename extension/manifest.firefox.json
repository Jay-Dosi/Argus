{
  "manifest_version": 3,
  "name": "Argus",
  "version": "1.0",
  "description": "Visual AI Browser Activity Agent",
  "browser_specific_settings": {
    "gecko": {
      "id": "argus@example.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
