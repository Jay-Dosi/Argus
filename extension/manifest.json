{
  "manifest_version": 3,
  "name": "Argus",
  "version": "1.0",
  "description": "Visual AI Browser Activity Agent",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "offscreen",
    "idle"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
